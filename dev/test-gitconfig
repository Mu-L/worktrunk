# The gitconfig `configure_git_env` points `GIT_CONFIG_GLOBAL` at, for every
# `git` the harness builds. Shared and read-only: the content is the same for
# every test, so `test_gitconfig_path()` hands out this path rather than
# writing a copy — nothing to create, nothing to race on, nothing to leak.
#
# It is `hermetic-gitconfig` plus an identity, and which file gets the identity
# follows from who reads each. `.cargo/config.toml` installs the floor for
# every process cargo starts, a developer's own `cargo run -- <cmd>` included,
# where a name would author their commits as Test User instead of failing. A
# harness-built git needs one because it commits into repos it has just
# created, before `LOCAL_TEST_CONFIG` reaches their local config — point this
# file at the floor instead and 17 tests fail on `Author identity unknown`.
#
# The include is what keeps the two from drifting: this file overrides the
# `GIT_CONFIG_GLOBAL` the floor is installed as, so restating those settings
# here would let a harness-built git resolve different config from the
# in-process git it is testing. A relative include path resolves against the
# including file, so this works wherever the checkout sits.

[include]
	path = hermetic-gitconfig

[user]
	name = Test User
	email = test@example.com
