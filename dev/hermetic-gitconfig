# The only git config outside a repository that worktrunk's test suite reads.
#
# `.cargo/config.toml` points both `GIT_CONFIG_GLOBAL` and `GIT_CONFIG_SYSTEM`
# at this file for every process cargo starts, so a `git` spawned in-process by
# a test — including one production code runs through `Repository::run_command`
# — resolves config from this file plus the fixture repo's own `.git/config`,
# never from the developer's `~/.gitconfig`. The sibling `test-gitconfig`, which
# `configure_git_env` installs over this one for harness-built commands,
# `[include]`s this file and adds an identity — so the two cannot drift.
#
# Both live in `dev/` rather than beside the other fixtures because that is the
# directory the crates.io archive and the `flake.nix` source filter already
# carry, and a path in `.cargo/config.toml` has to resolve wherever the checkout
# sits. `embedded_assets_ship_in_package` pins the rule.
#
# There is deliberately no `[user] name`/`email` here. Cargo installs this file
# for a developer's `cargo run -- <cmd>` as much as for the suite, so a name
# would author their commits as Test User; without one, `useConfigOnly` fails
# that commit instead. Tests read their identity from `test-gitconfig` and from
# each fixture repo's local config.

[user]
	useConfigOnly = true

[advice]
	mergeConflict = false
	resolveConflict = false

[init]
	defaultBranch = main

[commit]
	gpgsign = false

[rerere]
	enabled = true
